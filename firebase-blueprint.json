{
  "entities": {
    "Swarm": {
      "title": "Swarm",
      "description": "Represents an active multi-agent autonomous formal verification swarm and state tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the swarm session"
        },
        "ownerId": {
          "type": "string",
          "description": "The authenticated owner user UID"
        },
        "problemId": {
          "type": "string",
          "description": "The specific Millennium Prize mathematical track problem ID"
        },
        "targetTheorem": {
          "type": "string",
          "description": "Name of the target theorem"
        },
        "targetStatement": {
          "type": "string",
          "description": "Full formal statement in Lean 4"
        },
        "activePortfolioTier": {
          "type": "string",
          "description": "The computational and search depth portfolio tier"
        },
        "phase": {
          "type": "string",
          "description": "The current lifecycle phase of the swarm",
          "enum": ["idle", "running", "paused", "completed", "failed"]
        },
        "spent": {
          "type": "number",
          "description": "The cumulative computational budget spent"
        },
        "budget": {
          "type": "number",
          "description": "The total maximum budget ceiling allocated"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in epoch ms"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp in epoch ms"
        }
      },
      "required": ["id", "ownerId", "problemId", "targetTheorem"]
    }
  },
  "firestore": {
    "swarms/{swarmId}": {
      "schema": "Swarm",
      "description": "Active swarm session tracking documents"
    }
  }
}
