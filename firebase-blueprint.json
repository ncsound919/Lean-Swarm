{
  "entities": {
    "Swarm": {
      "title": "Swarm",
      "description": "A formal verification swarm for a specific theorem.",
      "type": "object",
      "properties": {
        "targetTheorem": { "type": "string", "maxLength": 256 },
        "targetStatement": { "type": "string", "maxLength": 2048 },
        "phase": { "type": "string", "enum": ["idle", "decomposing", "executing", "assembling", "finalizing"] },
        "spent": { "type": "number" },
        "budget": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
      },
      "required": ["targetTheorem", "targetStatement", "phase", "ownerId", "createdAt"]
    },
    "Lemma": {
      "title": "Lemma",
      "description": "A sub-lemma generated by the decomposer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^L[0-9]+$" },
        "title": { "type": "string", "maxLength": 128 },
        "statement": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["pending", "probing", "proving", "verified", "failed"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "proofHash": { "type": "string", "maxLength": 64 },
        "leanSource": { "type": "string", "maxLength": 8192 }
      },
      "required": ["id", "title", "statement", "status", "dependencies"]
    },
    "NegativeResult": {
      "title": "NegativeResult",
      "description": "A recorded failure or counterexample.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lemmaId": { "type": "string" },
        "failureType": { "type": "string", "enum": ["counterexample", "syntax_error", "tactic_timeout"] },
        "details": { "type": "string", "maxLength": 4096 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "lemmaId", "failureType", "details", "timestamp"]
    },
    "AgentState": {
      "title": "AgentState",
      "description": "The real-time status of a swarm agent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "job": { "type": "string" },
        "type": { "type": "string", "enum": ["AI", "DETERMINISTIC"] },
        "status": { "type": "string", "enum": ["idle", "working", "error"] },
        "lastLog": { "type": "string", "maxLength": 1024 },
        "model": { "type": "string" }
      },
      "required": ["id", "name", "job", "type", "status", "lastLog"]
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "A deterministic orchestrator log entry.",
      "type": "object",
      "properties": {
        "message": { "type": "string", "maxLength": 2048 },
        "timestamp": { "type": "number" }
      },
      "required": ["message", "timestamp"]
    }
  },
  "firestore": {
    "/swarms/{swarmId}": {
      "schema": "Swarm",
      "description": "Top-level swarm document."
    },
    "/swarms/{swarmId}/lemmas/{lemmaId}": {
      "schema": "Lemma",
      "description": "Sub-lemmas for a swarm."
    },
    "/swarms/{swarmId}/ledger/{entryId}": {
      "schema": "NegativeResult",
      "description": "Failed attempts ledger."
    },
    "/swarms/{swarmId}/agents/{agentId}": {
      "schema": "AgentState",
      "description": "Real-time agent status."
    },
    "/swarms/{swarmId}/logs/{logId}": {
      "schema": "LogEntry",
      "description": "Orchestrator logs."
    }
  }
}
